# Dedicated deployment account. Never commit the real value.
PRIVATE_KEY=

# Optional address overrides. Official addresses are selected by chain.
FXRP_ADDRESS=
UPSHIFT_VAULT_ADDRESS=

# Optional Flare RPC key. Official public RPCs are used when blank.
FLARE_RPC_API_KEY=

# Optional explicit RPC overrides.
COSTON2_RPC_URL=
FLARE_RPC_URL=

# Optional explorer API key and URL overrides.
FLARE_EXPLORER_API_KEY=
COSTON2_EXPLORER_URL=https://coston2-explorer.flare.network
FLARE_EXPLORER_URL=https://flare-explorer.flare.network

# Required only for an actual mainnet broadcast. Leave unset for preflight.
CONFIRM_MAINNET_DEPLOY=
