HYPERLIQUID_NETWORK=testnet

# Optional legacy operator account. Leave blank for per-user execution: each
# user gets their own API (agent) wallet, provisioned on demand and approved by
# that user via approveAgent. Never trade for users from a shared account.
HYPERLIQUID_ACCOUNT_ADDRESS=
HYPERLIQUID_API_WALLET_ADDRESS=

# Secret: the approved API wallet key. Never use NEXT_PUBLIC_*.
HYPERLIQUID_API_WALLET_PRIVATE_KEY=

# Secret shared only with the RippleFI server-side adapter.
HYPERLIQUID_SIGNER_AUTH_TOKEN=

# Fernet key encrypting each user's API-wallet private key at rest.
# Generate: python -c "from cryptography.fernet import Fernet;
# print(Fernet.generate_key().decode())"
HYPERLIQUID_CREDENTIAL_ENCRYPTION_KEY=

# Durable storage for per-user API wallets. Vercel KV aliases
# KV_REST_API_URL and KV_REST_API_TOKEN are also supported.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Safety policy.
HYPERLIQUID_MAX_ORDER_SIZE_XRP=1000
HYPERLIQUID_MAX_SLIPPAGE_BPS=100
HYPERLIQUID_MIN_ORDER_NOTIONAL_USD=10
HYPERLIQUID_MIN_HEDGE_SIZE_XRP=0
HYPERLIQUID_ALLOW_MAINNET=false
HYPERLIQUID_TESTNET_MARKETS=BTC,ETH,SOL
HYPERLIQUID_TESTNET_MAX_ORDER_SIZES=BTC:0.001,ETH:0.02,SOL:0.5

# Separate operator-only proof path. Disabled by default.
HYPERLIQUID_ENABLE_TESTNET_PROOF=false
HYPERLIQUID_TESTNET_PROOF_MARKET=BTC
HYPERLIQUID_TESTNET_PROOF_SIZE=0.0002
HYPERLIQUID_TESTNET_PROOF_MAX_NOTIONAL_USD=20

# Required only on a separately deployed mainnet signer.
HYPERLIQUID_MAINNET_MAX_ORDER_SIZE_XRP=

# Local service settings.
SIGNER_DB_PATH=./data/signer.db
SIGNER_HOST=127.0.0.1
SIGNER_PORT=8787
