# Create a project at https://cloud.reown.com and allow your production domain.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Used in WalletConnect metadata and mobile deep links.
NEXT_PUBLIC_APP_URL=https://ripple-fi.vercel.app

# Deployed RippleFIVault on Flare mainnet.
NEXT_PUBLIC_FLARE_VAULT_ADDRESS=0xef80F749b39638958A90F93E475321E28C2989Bf
NEXT_PUBLIC_FLARE_VAULT_DEPLOYMENT_BLOCK=66439645

# Xaman payload creation. Keep both values server-side.
XAMAN_API_KEY=
XAMAN_API_SECRET=

# Fund this private key with FLR and/or C2FLR for enabled networks.
SMART_ACCOUNT_EXECUTOR_PRIVATE_KEY=

# Used to sign short-lived Smart Account job tokens returned by the Xaman route.
SMART_ACCOUNT_JOB_SECRET=

# Shared wallet + chain Auto-Hedge state. Vercel KV aliases
# KV_REST_API_URL and KV_REST_API_TOKEN are also supported.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
AUTO_HEDGE_SESSION_SECRET=

# Flare FDC verifier credentials.
FDC_VERIFIER_URL=https://fdc-verifiers-testnet.flare.network
FDC_MAINNET_VERIFIER_URL=https://fdc-verifiers-mainnet.flare.network
FDC_VERIFIER_API_KEY=

# Optional infrastructure overrides.
COSTON2_RPC_URL=https://coston2-api.flare.network/ext/C/rpc
FLARE_RPC_URL=https://flare-api.flare.network/ext/C/rpc
XRPL_TESTNET_RPC_URL=https://s.altnet.rippletest.net:51234
XRPL_MAINNET_RPC_URL=https://xrplcluster.com
COSTON2_DA_LAYER_URL=https://ctn2-data-availability.flare.network
FLARE_DA_LAYER_URL=https://flr-data-availability.flare.network

# Default/fallback: records structured intents without placing a trade.
AUTO_HEDGE_EXECUTION_ADAPTER=record-intent-v1
AUTO_HEDGE_TESTNET_EXECUTION_ADAPTER=record-intent-v1
AUTO_HEDGE_MAINNET_EXECUTION_ADAPTER=record-intent-v1

# Public labels embedded in new intents. Keep aligned with server routing.
NEXT_PUBLIC_AUTO_HEDGE_TESTNET_VENUE=hyperliquid
NEXT_PUBLIC_AUTO_HEDGE_TESTNET_MARKET=BTC
NEXT_PUBLIC_AUTO_HEDGE_MAINNET_VENUE=hyperliquid
NEXT_PUBLIC_AUTO_HEDGE_MAINNET_MARKET=XRP

# RippleFI's own Hyperliquid signer service. Users never see or enter these.
# The signer provisions one API (agent) wallet per user and only trades for the
# user who approved it, so a shared operator account is never used.
HYPERLIQUID_SIGNER_URL=
HYPERLIQUID_SIGNER_AUTH_TOKEN=

# Optional: separate signer deployments per network.
HYPERLIQUID_TESTNET_SIGNER_URL=
HYPERLIQUID_TESTNET_SIGNER_AUTH_TOKEN=
HYPERLIQUID_MAINNET_SIGNER_URL=
HYPERLIQUID_MAINNET_SIGNER_AUTH_TOKEN=

HYPERLIQUID_TESTNET_MARKET=BTC

# Real-funds safety lock. Mainnet is disabled by default.
HYPERLIQUID_ALLOW_MAINNET=false

# Coston2 multi-market mode. Size is denominated in the selected market's
# units, so it is intentionally separate from the protected XRP amount.
AUTO_HEDGE_TESTNET_MARKETS=BTC,ETH,SOL
AUTO_HEDGE_TESTNET_ORDER_SIZE=0.0002

# SparkDEX Eternal isolated executor.
SPARKDEX_ETERNAL_EXECUTION_ENABLED=false
SPARKDEX_ETERNAL_MARKETS=XRP
SPARKDEX_ETERNAL_EXECUTOR_URL=
SPARKDEX_ETERNAL_EXECUTOR_AUTH_TOKEN=

# Flamix isolated executor.
FLAMIX_EXECUTION_ENABLED=false
FLAMIX_MARKETS=XRP,BTC,ETH
FLAMIX_EXECUTOR_URL=
FLAMIX_EXECUTOR_AUTH_TOKEN=
